# Google Drive storage needs OAuth clients from a Google Cloud project with the Drive API on
# (see README, "Google Drive"). Copy this file to .env.local and fill in the values.

# "Web application" client; its authorized JavaScript origins must include
# https://pinpad-taupe.vercel.app, http://localhost:5180 (dev) and http://localhost:4173 (preview).
VITE_GOOGLE_WEB_CLIENT_ID=
# The same origins, so the app can say where Drive works instead of showing Google's error.
VITE_GOOGLE_WEB_ORIGINS=

# "Desktop app" client, used by the Mac and Windows apps. Google treats this secret as
# non-confidential for installed apps, but keep it in .env.local, out of git.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# OneDrive storage needs an app registration in Microsoft Entra (portal.azure.com → App
# registrations → New registration), with "Accounts in any organizational directory and
# personal Microsoft accounts". Under Authentication add two platforms:
#   - Single-page application, redirect URIs: https://pinpad-taupe.vercel.app/ms-auth.html,
#     http://localhost:5180/ms-auth.html and http://localhost:4173/ms-auth.html
#   - Mobile and desktop applications, redirect URI: http://localhost
# Under API permissions add Microsoft Graph (delegated): Files.ReadWrite.AppFolder, User.Read
# and offline_access. Public client: no secret is needed.
VITE_MICROSOFT_CLIENT_ID=
# The website origins registered above, so the app can say where OneDrive works.
VITE_MICROSOFT_WEB_ORIGINS=

# Pinpad accounts (Sign in with email and password, top right) use Firebase: a project at
# console.firebase.google.com with Authentication → Email/Password turned on, and a Firestore
# database whose rules let each user read and write only users/<their uid>. These come from
# Project settings → Your apps → Web app; they identify the project and aren't secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
