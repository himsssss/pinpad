{
  "name": "pinpad",
  "private": true,
  "version": "0.4.0",
  "description": "Pinpad: boards for notes, images, links and to-dos.",
  "author": "Himanshu Singh",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "build:mac": "./macos/build.sh",
    "install:mac": "./macos/install.sh",
    "desktop": "npm run build && electron .",
    "build:win": "npm run build && electron-builder --win --x64 --arm64",
    "icons:win": "python3 desktop/make-icons.py"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "immer": "^10.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.pinpad.app",
    "productName": "Pinpad",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/assets/icon.png",
      "dist/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pinpad",
      "artifactName": "Pinpad-Setup-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@sentry/react": "11.7.0",
    "html-to-image": "^1.11.11",
    "jspdf": "^2.5.2",
    "pdfjs-dist": "^4.10.38"
  }
}
