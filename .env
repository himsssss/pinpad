# Public OAuth client ids for Google Drive storage (Google Cloud project pinpad-512915).
# Client ids aren't secret; the desktop client's secret lives in .env.local (see .env.example).
VITE_GOOGLE_WEB_CLIENT_ID=823259253794-3g18ei54sn192greeu9dbm862s067c1h.apps.googleusercontent.com
VITE_GOOGLE_DESKTOP_CLIENT_ID=823259253794-m6cfnjc2kpl0e626feacgl8qois2h926.apps.googleusercontent.com
# The web client's authorized JavaScript origins; elsewhere Google refuses sign-in (origin_mismatch).
VITE_GOOGLE_WEB_ORIGINS=http://localhost:5180,http://localhost:4173,https://pinpad-taupe.vercel.app

# Public client id for OneDrive storage (Microsoft Entra app registration "Pinpad"; not secret).
VITE_MICROSOFT_CLIENT_ID=
# The website addresses registered as single-page app redirect URIs (…/ms-auth.html at each).
VITE_MICROSOFT_WEB_ORIGINS=http://localhost:5180,http://localhost:4173,https://pinpad-taupe.vercel.app
